{
  "name": "kottabos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser party game with authoritative multiplayer, touch controls and recovery.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node scripts/dev.js",
    "build": "vite build",
    "start:prod": "node scripts/production.js",
    "test": "node --test tests/*.test.js",
    "test:expiry": "node --test tests/acceptance/expiry.js",
    "test:twelve": "node --test tests/acceptance/twelve-player.test.js",
    "test:remote": "playwright test --config playwright.remote.config.js",
    "test:browser": "playwright test",
    "test:production": "node --test tests/acceptance/production.test.js && playwright test --config playwright.production.config.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@colyseus/core": "0.18.14",
    "@colyseus/schema": "5.0.32",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  }
}
